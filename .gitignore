# Build output
/bin/
/dist/
/fyne-cross/
*.exe
*.test
*.out
coverage.html

# Stray root build artifacts (binaries produced by `go build ./cmd/...` and
# scratch mains) — never commit them (#41, #114).
/helena
/covergate
/cmd_gojatest_main.go

# Jekyll project website build artifacts (website/). The site builds with
# dockerized Ruby, so the gem cache + lock are per-environment (the lock would
# otherwise pin a single container arch, e.g. x86_64 vs Apple-Silicon arm64).
/website/_site/
/website/.jekyll-cache/
/website/.bundle/
/website/Gemfile.lock

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local Claude Code config (machine-specific permission grants)
.claude/
