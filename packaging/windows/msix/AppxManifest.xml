<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store submission of Helena.

  The Identity values below are the ones Partner Center assigned to this product
  (Store ID 9NWPKK6CTDR1, PFN IdeaConnectBartoszPachoek.HelenaAPIClient_aec6mzqn7e0rm)
  and MUST match Partner Center exactly or the Store rejects the upload. Only
  @VERSION@ and @ARCH@ are build-time tokens, substituted per build by
  build-msix.ps1. See packaging/windows/msix/README.md and docs/PACKAGING.md.

  Helena ships as a full-trust Win32 executable wrapped in MSIX
  (EntryPoint="Windows.FullTrustApplication" + the runFullTrust capability), not
  a UWP app.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="IdeaConnectBartoszPachoek.HelenaAPIClient"
      Publisher="CN=776E87F3-6B20-4A52-B4D8-AA515F574757"
      Version="@VERSION@"
      ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>Helena</DisplayName>
    <PublisherDisplayName>IDCT Bartosz Pachołek</PublisherDisplayName>
    <Description>A small, single-binary API client - a native alternative to Postman and Bruno.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Helena" Executable="helena.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Helena"
          Description="A small, single-binary API client - a native alternative to Postman and Bruno."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
